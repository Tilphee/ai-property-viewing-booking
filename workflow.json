    {
      "parameters": {
        "jsCode": "const fields = $input.first().json.body.data.fields;\n\nconst get = (label) => {\n  const f = fields.find(x => (x.label || '').toLowerCase().trim() === label.toLowerCase());\n  if (!f) return '';\n  let v = f.value;\n  if (Array.isArray(v) && f.options) {\n    v = v.map(id => (f.options.find(o => o.id === id) || {}).text).join(', ');\n  }\n  return v ?? '';\n};\n\nreturn [{\n  json: {\n    name: get('Full name'),\n    email: get('Email address'),\n    phone: get('Phone number'),\n    property: get('Property'),\n    customProperty: get('Which property or area are you interested in?'),\n    date: get('Preferred viewing date'),\n    time: get('Preferred viewing time'),\n    notes: get('Notes')\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        -96
      ],
      "id": "8b7c7daf-ebf8-41df-b0ff-9e0277bff938",
      "name": "\tClean Form Data"
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst [time, ampm] = d.time.trim().split(' ');\nlet [h, m] = time.split(':').map(Number);\nif (ampm.toUpperCase() === 'PM' && h !== 12) h += 12;\nif (ampm.toUpperCase() === 'AM' && h === 12) h = 0;\nconst pad = n => String(n).padStart(2, '0');\n\nreturn [{\n  json: {\n    ...d,\n    start: `${d.date}T${pad(h)}:${pad(m)}:00+01:00`,\n    end: `${d.date}T${pad(h + 1)}:${pad(m)}:00+01:00`\n  }\n}];"
      },
